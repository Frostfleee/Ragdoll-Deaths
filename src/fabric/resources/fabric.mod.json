{
	"schemaVersion": 1,
	"id": "ragdolldeaths",
	"version": "${version}",
	"name": "Ragdoll Deaths",
	"description": "Dead mobs become real physics ragdolls, thrown by the blow that killed them: they tumble down stairs, slump against walls, float in water and burn where lava touched them. Client-side and purely visual.",
	"authors": [
		"Frostfleee"
	],
	"license": "MIT",
	"icon": "assets/ragdolldeaths/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.frostfleee.ragdolldeaths.fabric.FabricClient"
		],
		"modmenu": [
			"com.frostfleee.ragdolldeaths.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "ragdolldeaths.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "${minecraftRange}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
