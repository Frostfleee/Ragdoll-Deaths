{
	"schema_version": 1,
	"quilt_loader": {
		"group": "com.frostfleee",
		"id": "ragdolldeaths",
		"version": "${version}",
		"metadata": {
			"name": "Ragdoll Deaths",
			"description": "Every mob dies with its own jointed death animation that reacts to the killing blow: zombies fall back, horses roll onto their side, skeletons fall apart and blazes drop their rods. Client-side and purely visual.",
			"contributors": {
				"Frostfleee": "Owner"
			},
			"license": "MIT",
			"icon": "assets/ragdolldeaths/icon.png"
		},
		"entrypoints": {
			"client": "com.frostfleee.ragdolldeaths.fabric.FabricClient",
			"modmenu": "com.frostfleee.ragdolldeaths.fabric.ModMenuIntegration"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.30.1"
			},
			{
				"id": "minecraft",
				"versions": "${minecraftRange}"
			},
			{
				"id": "java",
				"versions": ">=25"
			},
			{
				"id": "fabric-api",
				"versions": "*"
			}
		]
	},
	"mixin": "ragdolldeaths.mixins.json",
	"minecraft": {
		"environment": "client"
	}
}
